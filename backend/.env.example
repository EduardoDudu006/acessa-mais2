# Configurações da Aplicação
PROJECT_NAME="ACESSA+ API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Banco local persistente (não requer instalação de PostgreSQL)
DATABASE_URL=sqlite:///./acessa_local.db

# Segurança e JWT
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend permitido durante desenvolvimento (separar origens por vírgula)
CORS_ORIGINS=http://localhost:5173

# Identificação exigida pelo serviço público Nominatim/OpenStreetMap
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=AcessaMais/1.0 (https://github.com/EduardoDudu006/acessa-mais2)

# Serviço de roteamento pedestre (Valhalla)
VALHALLA_URL=https://valhalla1.openstreetmap.de/route
