{
    "expo": {
        "name": "ACESSA+",
        "slug": "acessa-mais",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/Icone-Acessa-Mais.png",
        "userInterfaceStyle": "light",
        "splash": {
            "image": "./assets/logo-completo.png",
            "resizeMode": "contain",
            "backgroundColor": "#041E42"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.eduardodudu006.acessamais",
            "infoPlist": {
                "NSLocationWhenInUseUsageDescription": "O ACESSA+ precisa da sua localização para mapear obstáculos e calcular rotas acessíveis nas calçadas de Recife.",
                "NSCameraUsageDescription": "O ACESSA+ utiliza a câmera para fotografar e registrar problemas de acessibilidade urbana."
            }
        },
        "android": {
            "package": "com.eduardodudu006.acessamais",
            "permissions": [
                "ACCESS_FINE_LOCATION",
                "ACCESS_COARSE_LOCATION",
                "CAMERA",
                "READ_EXTERNAL_STORAGE",
                "WRITE_EXTERNAL_STORAGE"
            ]
        },
        "web": {
            "favicon": "./assets/Icone-Acessa-Mais.png"
        }
    }
}